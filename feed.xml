---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ site.name | append: " - News" | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ "/" | absolute_url }}</link>
    <atom:link href="{{ "/feed.xml" | absolute_url }}" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <language>en-us</language>
    <generator>Jekyll</generator>
    <ttl>60</ttl>
    {% if site.contact_urls.email.value %}
    <managingEditor>{{ site.contact_urls.email.value | xml_escape }} ({{ site.name | xml_escape }})</managingEditor>
    <webMaster>{{ site.contact_urls.email.value | xml_escape }} ({{ site.name | xml_escape }})</webMaster>
    {% endif %}
    {% if site.icon %}
    <image>
      <url>{{ site.icon | absolute_url }}</url>
      <title>{{ site.name | xml_escape }}</title>
      <link>{{ "/" | absolute_url }}</link>
    </image>
    {% endif %}
    {% for item in site.data.news limit:20 %}
    {% assign item_title = item.title | strip_html | normalize_whitespace %}
    {% assign item_description = item.title | strip_html | normalize_whitespace %}
    {% assign item_date = item.date | date_to_rfc822 %}
    {% assign item_anchor = item.date | slugify | prepend: "news-" | append: "-" | append: forloop.index %}
    {% assign item_url = "/" | append: "#" | append: item_anchor | absolute_url %}
    <item>
      <title>{{ item_title | xml_escape }}</title>
      <dc:creator>{{ site.name | xml_escape }}</dc:creator>
      <category>{{ item.label | default: "news" | xml_escape }}</category>
      <description>{{ item_description | xml_escape }}</description>
      <content:encoded><![CDATA[{{ item.title }}]]></content:encoded>
      <pubDate>{{ item_date }}</pubDate>
      <link>{{ item_url }}</link>
      <guid isPermaLink="true">{{ item_url }}</guid>
    </item>
    {% endfor %}
  </channel>
</rss>
